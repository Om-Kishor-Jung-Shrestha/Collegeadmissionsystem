PORT=8000
NODE_ENV=development

# MongoDB (use local OR Atlas)
# Local:  MONGO_URI=mongodb://127.0.0.1:27017/coursehub
# Atlas:  MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/collegeadmissionform

# Upstash Redis — get from console.upstash.com
UPSTASH_REDIS_URL=https://xxxx.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_rest_token

# JWT Secrets — auto-generated by scripts/setup-env.js on first run
ACCESS_TOKEN=your_access_jwt_secret_min_32_chars_here
REFRESH_TOKEN=your_refresh_jwt_secret_min_32_chars_here

# Cloudinary — get from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP
# Port 587 (STARTTLS) → SMTP_SECURE=false
# Port 465 (SSL)      → SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL (for CORS + OAuth redirect)
ORIGIN=http://localhost:5173



# Platform name (shown in emails)
PLATFORM_NAME=Collegeadmissionmanagementsystem